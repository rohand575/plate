# Copy to .env.local for local development. On Vercel, add the same variables under
# Project → Settings → Environment Variables (you can paste this whole file there).

# --- Firebase web app config (public; built into the app) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (never sent to the browser) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-6.1-terra             # food analysis (text + photos)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe # speech to text
# OPENAI_REASONING_EFFORT=low            # none | low | medium | high
# AI_DAILY_LIMIT=40                      # AI logs per person per day
# ALLOWED_EMAILS=you@example.com,friend@example.com   # only these accounts can use AI
