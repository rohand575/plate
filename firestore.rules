rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each person can only ever see and change their own data.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.meal in ['breakfast', 'lunch', 'snack', 'dinner']
          && request.resource.data.totals.kcal is number
          && request.resource.data.totals.kcal >= 0
          && request.resource.data.totals.kcal < 20000
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50;
      }

      match /favourites/{favouriteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 80
          && request.resource.data.meal in ['breakfast', 'lunch', 'snack', 'dinner']
          && request.resource.data.totals.kcal is number
          && request.resource.data.totals.kcal >= 0
          && request.resource.data.totals.kcal < 20000
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50;
      }

      match /weights/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.kg is number
          && request.resource.data.kg > 20
          && request.resource.data.kg < 400;
      }

      // Daily AI usage counter, written by /api/analyze with the person's own sign-in.
      // It can only start at 1 and go up by exactly 1, and can't be deleted — so the
      // daily limit can't be reset from the app.
      match /usage/{day} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['count', 'day', 'updatedAt'])
          && request.resource.data.count == 1;
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['count', 'day', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
      }
    }

    // Everything else is denied.
  }
}
