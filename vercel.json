{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://plate-4c81f.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://plate-4c81f.firebaseapp.com/__/firebase/:path*" },
    { "source": "/((?!api/|__/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
